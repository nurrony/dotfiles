# type: ignore
# key bindings
bindkey -e
bindkey "^[[A" history-search-backward
bindkey "^[[B" history-search-forward


# Key bindings & paste behavior
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
zle_highlight=('paste:none')

# History configuration
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

# History options (Redundant duplicates removed)
setopt append_history          # Standard Zsh default, explicit append
setopt share_history           # Share history live across sessions (implies inc_append_history)
setopt hist_ignore_space       # Don't record commands leading with a space
setopt hist_ignore_all_dups    # Remove older duplicate entries when adding new ones
setopt hist_find_no_dups       # Don't show duplicate history results when searching
setopt hist_save_no_dups       # Skip writing duplicates to $HISTFILE
setopt hist_reduce_blanks      # Strip excess white space from commands
setopt hist_verify             # Allow editing history expansion before running

# Shell options
setopt auto_cd                 # cd into directory if name is entered as a command
setopt extended_glob           # Enable advanced globbing syntax (#, ~, ^)
setopt numeric_glob_sort       # Sort filenames numerically (1, 2, 10 instead of 1, 10, 2)
# auto_list and nomatch left at Zsh defaults (enabled by default)

# Completion styles
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' verbose yes
zstyle ':completion:*' group-name ''
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}

# Formatting & feedback
zstyle ':completion:*:descriptions' format ' %F{yellow}-- %d --%f'
zstyle ':completion:*:corrections' format ' %F{green}-- %d (errors: %e) --%f'
zstyle ':completion:*:messages' format ' %F{purple} -- %d --%f'
zstyle ':completion:*:warnings' format ' %F{red}-- no matches found --%f'
zstyle ':completion:*:default' list-prompt '%S%M matches%s'
zstyle ':completion:*:options' auto-description '%d'
zstyle ':completion:*:functions' ignored-patterns '(_*|pre(cmd|exec))'
