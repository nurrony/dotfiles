#!/usr/bin/env zsh
# ==============================================================================
# Optimized & Hardened FZF Configuration for Zsh
# ==============================================================================

# Guard: Ensure fzf is installed before proceeding
if ! command -v fzf &>/dev/null; then
    return 1
fi

# Initialize fzf key bindings and fuzzy completion
source <(fzf --zsh)

# ------------------------------------------------------------------------------
# Environment & Command Optimization
# ------------------------------------------------------------------------------

# Safe file search: Include hidden files but strictly ignore .git internals
if command -v rg &>/dev/null; then
    export FZF_DEFAULT_COMMAND="rg --files --hidden --glob '!.git/*'"
else
    export FZF_DEFAULT_COMMAND="find . -type f -not -path '*/.git/*'"
fi

export FZF_DEFAULT_OPTS="--multi --height 70% --layout=default --border --color=hl:#fbb388"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--multi --preview 'bat --color=always -n --line-range :100 {}'"

# Fixed directory search: Use 'fd' if available (preferred), fallback to safe find/rg
if command -v fd &>/dev/null; then
    export FZF_ALT_C_COMMAND="fd --type d --hidden --exclude .git"
elif command -v rg &>/dev/null; then
    export FZF_ALT_C_COMMAND="rg --files --hidden --glob '*/' --glob '!.git/*'"
else
    export FZF_ALT_C_COMMAND="find . -type d -not -path '*/.git/*'"
fi

export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {} | head -200'"

# ------------------------------------------------------------------------------
# Custom Utility Functions (Hardened & Robust)
# ------------------------------------------------------------------------------

# Interactive Process Killer (Cross-platform and safer PID extraction)
nmr_fzf_kill() {
    local pid
    pid=$(ps -ef | sed 1d | fzf --header="[Kill Process]" --preview="echo {}" | awk '{print $2}')
    if [[ -n "$pid" ]]; then
        echo "Terminating PID: $pid"
        kill -9 "$pid"
    fi
}

# Git Reflog Picker
nmr_fzf_git_reflog() {
    local selection
    selection=$(git reflog --color=always "$@" | fzf --no-multi --ansi --no-sort --height 80% \
        --preview "git show --color=always \$(echo {} | awk '{print \$1}')")
    if [[ -n "$selection" ]]; then
        local commit=$(echo "$selection" | awk '{print $1}')
        git show "$commit"
    fi
}
