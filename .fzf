#!/usr/bin/env zsh
# ==============================================================================
# Optimized & Hardened FZF Configuration for Zsh
# ==============================================================================

# Guard: Ensure fzf is installed before proceeding
if ! command -v fzf &>/dev/null; then
    return 1
fi

# Initialize fzf key bindings and fuzzy completion
source <(fzf --zsh)

# ------------------------------------------------------------------------------
# Environment & Command Optimization
# ------------------------------------------------------------------------------

# Safe file search: Include hidden files but strictly ignore .git internals
if command -v rg &>/dev/null; then
    export FZF_DEFAULT_COMMAND="rg --files --hidden --glob '!.git/*'"
else
    export FZF_DEFAULT_COMMAND="find . -type f -not -path '*/.git/*'"
fi

export FZF_DEFAULT_OPTS="--multi --height 70% --layout=default --border --color=hl:#fbb388"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--multi --preview 'bat --color=always -n --line-range :100 {}'"

# Fixed directory search: Use 'fd' if available (preferred), fallback to safe find/rg
if command -v fd &>/dev/null; then
    export FZF_ALT_C_COMMAND="fd --type d --hidden --exclude .git"
elif command -v rg &>/dev/null; then
    export FZF_ALT_C_COMMAND="rg --files --hidden --glob '*/' --glob '!.git/*'"
else
    export FZF_ALT_C_COMMAND="find . -type d -not -path '*/.git/*'"
fi

export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {} | head -200'"

# ------------------------------------------------------------------------------
# Custom Utility Functions (Hardened & Robust)
# ------------------------------------------------------------------------------

# Interactive Process Killer (Cross-platform and safer PID extraction)
nmr_fzf_kill() {
    local pid
    pid=$(ps -ef | sed 1d | fzf --header="[Kill Process]" --preview="echo {}" | awk '{print $2}')
    if [[ -n "$pid" ]]; then
        echo "Terminating PID: $pid"
        kill -9 "$pid"
    fi
}

# Git Reflog Picker
nmr_fzf_git_reflog() {
    local selection
    selection=$(git reflog --color=always "$@" | fzf --no-multi --ansi --no-sort --height 80% \
        --preview "git show --color=always \$(echo {} | awk '{print \$1}')")
    if [[ -n "$selection" ]]; then
        local commit=$(echo "$selection" | awk '{print $1}')
        git show "$commit"
    fi
}

# Git Log Pickaxe (Search code introduction/removal history)
nmr_fzf_git_log_pickaxe() {
    if [[ $# == 0 ]]; then
        echo 'Error: Search term was not provided.' >&2
        return 1
    fi
    local selection
    selection=$(git log --oneline --color=always -S "$@" | fzf --no-multi --ansi --no-sort --height 80% \
        --preview "git show --color=always \$(echo {} | awk '{print \$1}')")
    if [[ -n "$selection" ]]; then
        local commit=$(echo "$selection" | awk '{print $1}')
        git show "$commit"
    fi
}

# Advanced Git Branch Checkout with Live Graph Previews & Remote Tracking
nmr_fzf_git_checkout() {
    # 1. Ensure we are inside a valid git working tree
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: Not a git repository." >&2
        return 1
    fi

    local selection branch clean_branch

    # 2. Launch fzf with a dual-pane layout and dynamic log preview
    selection=$(git branch -a --color=always --no-column --format='%(if)%(HEAD)%(then)* %(else)  %(end)%(refname:short)' | \
        fzf --ansi \
            --height 75% \
            --layout=reverse \
            --border \
            --prompt="Checkout Branch ❯ " \
            --pointer="▶" \
            --marker="✓" \
            --header="[Enter: Checkout | Esc: Cancel]" \
            --preview='
                # Strip leading markers (*, spaces) to get exact branch name
                b=$(echo {} | sed "s/^[ *]*//")
                # If it is a remote branch, trim remote prefix for log check if needed, or inspect directly
                git log --graph --color=always --oneline --max-count=100 --date=relative \
                    --pretty=format:"%C(yellow)%h%C(reset) - %C(cyan)%an%C(reset): %s %C(green)(%ar)%C(reset)" "$b" 2>/dev/null || \
                git log --graph --color=always --oneline --max-count=100 "$b"
            ' \
            --preview-window=right:65%:wrap)

    # 3. Process selection and perform checkout
    if [[ -n "$selection" ]]; then
        # Clean up formatting to extract the exact branch name
        branch=$(echo "$selection" | sed 's/^[ *]*//')

        # Strip trailing pointers like ' -> origin/HEAD' if present
        branch="${branch%% *}"

        # If user selected a remote branch (e.g., origin/feature-x) that doesn't have a local counterpart
        if [[ "$branch" == origin/* ]] && [[ "$branch" != */HEAD ]]; then
            clean_branch="${branch#origin/}"
            if git show-ref --verify --quiet "refs/heads/$clean_branch"; then
                echo "Switching to existing local branch: $clean_branch"
                git checkout "$clean_branch"
            else
                echo "Tracking remote branch '$clean_branch' from '$branch'..."
                git checkout --track "$branch"
            fi
        else
            git checkout "$branch"
        fi
    fi
}


# Advanced Interactive Git Stash Manager with Patch Preview & Action Controls
nmr_fzf_git_stash() {
    # 1. Ensure we are inside a valid git working tree
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: Not a git repository." >&2
        return 1
    fi

    # 2. Check if stashes exist
    if ! git stash list &>/dev/null || [[ -z "$(git stash list)" ]]; then
        echo "Notice: No stashes found in this repository." >&2
        return 0
    fi

    local output action selection stash_id

    # 3. Launch fzf with expected action keys and live patch inspection preview
    output=$(git stash list --color=always | \
        fzf --ansi \
            --height 75% \
            --layout=reverse \
            --border \
            --prompt="Stash Manager ❯ " \
            --header="[Enter: Pop | Ctrl+A: Apply | Ctrl+D: Drop | Esc: Cancel]" \
            --expect=ctrl-a,ctrl-d,enter \
            --preview='
                # Extract stash identifier (e.g., stash@{0})
                s=$(echo {} | cut -d: -f1)
                git stash show -p --color=always "$s"
            ' \
            --preview-window=right:50%:wrap)

    # 4. Parse output: line 1 is the key pressed, line 2+ is the selected item
    action=$(echo "$output" | head -n1)
    selection=$(echo "$output" | sed -n '2p')

    if [[ -z "$selection" ]]; then
        return 0
    fi

    # Extract the strict stash reference (e.g., stash@{0})
    stash_id=$(echo "$selection" | cut -d: -f1)

    # 5. Execute action based on key pressed
    case "$action" in
        ctrl-d)
            echo "Dropping stash: $stash_id"
            git stash drop "$stash_id"
            ;;
        ctrl-a)
            echo "Applying stash (retaining in list): $stash_id"
            git stash apply "$stash_id"
            ;;
        enter|"")
            echo "Popping stash (applying and removing): $stash_id"
            git stash pop "$stash_id"
            ;;
    esac

}

# ==============================================================================
# Advanced Interactive Git Rebase & Commit Reordering Helper
# ==============================================================================
nmr_fzf_rebase() {
    # 1. Ensure we are inside a valid git working tree
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: Not a git repository." >&2
        return 1
    fi

    local count selection action target_branch
    count="${1:-20}" # Default to last 20 commits if no argument passed

    # 2. Launch fzf with multi-select and action keybindings
    # Selecting commits in a specific order determines the new reorder sequence.
    selection=$(git log --oneline --color=always -n "$count" | \
        fzf --ansi \
            --multi \
            --height 80% \
            --layout=reverse \
            --border \
            --prompt="Rebase & Reorder > " \
            --header="[Enter: Pick | Ctrl+S: Squash | Ctrl+E: Edit | Ctrl+D: Drop]" \
            --expect=ctrl-s,ctrl-e,ctrl-d,enter \
            --preview '
                commit_hash=$(echo {} | awk "{print \$1}")
                git show --color=always "$commit_hash"
            ' \
            --preview-window=right:55%:wrap)

    if [[ -z "$selection" ]]; then
        echo "Rebase cancelled."
        return 0
    fi

    # 3. Parse action and selected commit hashes
    action=$(echo "$selection" | head -n1)
    local commits=($(echo "$selection" | sed '1d' | awk '{print $1}'))

    if [[ ${#commits[@]} -eq 0 ]]; then
        echo "No commits selected."
        return 1
    fi

    # Determine base parent commit for the interactive rebase range
    local base_commit="${commits[-1]}"
    local parent_commit
    parent_commit=$(git rev-parse "$base_commit~1" 2>/dev/null)

    if [[ -z "$parent_commit" ]]; then
        echo "Error: Cannot rebase past root commit easily with this helper." >&2
        return 1
    fi

    # Map the chosen action modifier
    local default_action="pick"
    case "$action" in
        ctrl-s) default_action="squash" ;;
        ctrl-e) default_action="edit" ;;
        ctrl-d) default_action="drop" ;;
        enter|"") default_action="pick" ;;
    esac

    echo "Preparing interactive rebase starting from parent: $parent_commit using action: '$default_action'..."

    # 4. Construct a temporary sequence script for GIT_SEQUENCE_EDITOR
    local seq_file
    seq_file=$(mktemp)

    # Write out the reorder sequence based on user's exact multi-select order
    # Note: Reverse array since git rebase todo expects chronological order (oldest top, newest bottom)
    for (( i=${#commits[@]}; i>=1; i-- )); do
        echo "$default_action ${commits[i]}" >> "$seq_file"
    done

    # Execute rebase using the custom sequence file
    GIT_SEQUENCE_EDITOR="cat $seq_file" git rebase -i "$parent_commit"

    # Cleanup temporary file
    rm -f "$seq_file"
}
